<%!-- Premium Landing Page for ClinicFlow --%>
<%!-- Editorial Medical Luxury aesthetic - confident, warm, sophisticated --%>

<style>
  /* ═══════════════════════════════════════════════════════════════
     CLINICFLOW PREMIUM LANDING PAGE
     Aesthetic: Editorial Medical Luxury
     ═══════════════════════════════════════════════════════════════ */

  /* Import distinctive fonts */
  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

  :root {
    /* Color System - Deep, confident, warm */
    --cf-navy: #0f172a;
    --cf-navy-90: #1e293b;
    --cf-slate: #334155;
    --cf-slate-light: #64748b;
    --cf-warm-white: #fafaf9;
    --cf-cream: #f5f5f4;
    --cf-accent: #0ea5e9;
    --cf-accent-dark: #0284c7;
    --cf-accent-glow: rgba(14, 165, 233, 0.15);
    --cf-success: #10b981;
    --cf-urgent: #f59e0b;
    --cf-emergency: #ef4444;

    /* Typography */
    --font-display: 'Instrument Serif', Georgia, serif;
    --font-body: 'Plus Jakarta Sans', system-ui, sans-serif;

    /* Spacing rhythm */
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 1.5rem;
    --space-lg: 2.5rem;
    --space-xl: 4rem;
    --space-2xl: 6rem;
    --space-3xl: 10rem;

    /* Transitions */
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --transition-base: 0.4s var(--ease-out-expo);
  }

  /* Reset & Base */
  .landing-page * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .landing-page {
    font-family: var(--font-body);
    color: var(--cf-navy);
    background: var(--cf-warm-white);
    overflow-x: hidden;
    line-height: 1.6;
  }

  /* ═══════════════════════════════════════════════════════════════
     NAVIGATION
     ═══════════════════════════════════════════════════════════════ */

  .cf-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: var(--space-md) var(--space-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(250, 250, 249, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    transition: var(--transition-base);
  }

  .cf-nav.scrolled {
    padding: var(--space-sm) var(--space-xl);
    box-shadow: 0 4px 30px rgba(15, 23, 42, 0.08);
  }

  .cf-logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--cf-navy);
  }

  .cf-logo-mark {
    width: 42px;
    height: 42px;
    background: linear-gradient(135deg, var(--cf-accent) 0%, var(--cf-accent-dark) 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px var(--cf-accent-glow);
  }

  .cf-logo-mark svg {
    width: 24px;
    height: 24px;
    color: white;
  }

  .cf-logo-text {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .cf-nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .cf-nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--cf-slate);
    text-decoration: none;
    transition: color 0.2s ease;
    position: relative;
  }

  .cf-nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--cf-accent);
    transition: width 0.3s var(--ease-out-expo);
  }

  .cf-nav-link:hover {
    color: var(--cf-navy);
  }

  .cf-nav-link:hover::after {
    width: 100%;
  }

  .cf-nav-cta {
    padding: 0.75rem 1.5rem;
    background: var(--cf-navy);
    color: white;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: 100px;
    text-decoration: none;
    transition: all 0.3s var(--ease-out-expo);
    box-shadow: 0 2px 10px rgba(15, 23, 42, 0.15);
  }

  .cf-nav-cta:hover {
    background: var(--cf-navy-90);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.25);
  }

  /* ═══════════════════════════════════════════════════════════════
     HERO SECTION
     ═══════════════════════════════════════════════════════════════ */

  .cf-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: calc(var(--space-3xl) + 80px) var(--space-xl) var(--space-3xl);
    position: relative;
    overflow: hidden;
  }

  .cf-hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 60%;
    height: 100%;
    background: radial-gradient(ellipse at 70% 30%, var(--cf-accent-glow) 0%, transparent 60%);
    pointer-events: none;
  }

  .cf-hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-2xl);
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    align-items: center;
  }

  .cf-hero-content {
    animation: fadeInUp 1s var(--ease-out-expo) 0.2s both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cf-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.5rem 1rem;
    background: var(--cf-cream);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--cf-slate);
    margin-bottom: var(--space-lg);
  }

  .cf-hero-badge-dot {
    width: 8px;
    height: 8px;
    background: var(--cf-success);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.2); }
  }

  .cf-hero-headline {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5.5vw, 4.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--cf-navy);
    margin-bottom: var(--space-md);
  }

  .cf-hero-headline em {
    font-style: italic;
    color: var(--cf-accent-dark);
  }

  .cf-hero-subhead {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--cf-slate);
    max-width: 540px;
    margin-bottom: var(--space-xl);
  }

  .cf-hero-actions {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }

  .cf-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 1.1rem 2rem;
    background: var(--cf-accent);
    color: white;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 100px;
    text-decoration: none;
    transition: all 0.3s var(--ease-out-expo);
    box-shadow: 0 4px 20px var(--cf-accent-glow);
  }

  .cf-btn-primary:hover {
    background: var(--cf-accent-dark);
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(14, 165, 233, 0.35);
  }

  .cf-btn-primary svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s var(--ease-out-expo);
  }

  .cf-btn-primary:hover svg {
    transform: translateX(4px);
  }

  .cf-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 1.1rem 1.5rem;
    color: var(--cf-slate);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .cf-btn-secondary:hover {
    color: var(--cf-navy);
  }

  .cf-btn-secondary svg {
    width: 20px;
    height: 20px;
  }

  /* Hero Visual - Queue Mockup */
  .cf-hero-visual {
    position: relative;
    animation: fadeInUp 1s var(--ease-out-expo) 0.5s both;
  }

  .cf-queue-mockup {
    background: white;
    border-radius: 24px;
    box-shadow:
      0 4px 6px rgba(15, 23, 42, 0.02),
      0 12px 24px rgba(15, 23, 42, 0.05),
      0 24px 48px rgba(15, 23, 42, 0.08);
    overflow: hidden;
    border: 1px solid rgba(15, 23, 42, 0.06);
  }

  .cf-mockup-header {
    padding: var(--space-md) var(--space-lg);
    background: var(--cf-navy);
    color: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cf-mockup-title {
    font-size: 0.95rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .cf-mockup-title svg {
    width: 18px;
    height: 18px;
    opacity: 0.7;
  }

  .cf-mockup-stats {
    display: flex;
    gap: var(--space-md);
  }

  .cf-mockup-stat {
    text-align: center;
  }

  .cf-mockup-stat-value {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .cf-mockup-stat-label {
    font-size: 0.7rem;
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cf-mockup-body {
    padding: var(--space-md);
  }

  .cf-queue-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .cf-queue-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
    background: var(--cf-cream);
    border-radius: 12px;
    transition: all 0.4s var(--ease-out-expo);
    animation: slideIn 0.6s var(--ease-out-expo) both;
  }

  .cf-queue-item:nth-child(1) { animation-delay: 0.7s; }
  .cf-queue-item:nth-child(2) { animation-delay: 0.85s; }
  .cf-queue-item:nth-child(3) { animation-delay: 1s; }
  .cf-queue-item:nth-child(4) { animation-delay: 1.15s; }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .cf-queue-item:hover {
    background: white;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
    transform: translateX(4px);
  }

  .cf-queue-position {
    width: 32px;
    height: 32px;
    background: var(--cf-navy);
    color: white;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .cf-queue-item.emergency .cf-queue-position {
    background: var(--cf-emergency);
  }

  .cf-queue-item.urgent .cf-queue-position {
    background: var(--cf-urgent);
  }

  .cf-queue-info {
    flex: 1;
  }

  .cf-queue-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--cf-navy);
  }

  .cf-queue-reason {
    font-size: 0.8rem;
    color: var(--cf-slate-light);
  }

  .cf-queue-eta {
    text-align: right;
  }

  .cf-queue-eta-time {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--cf-navy);
  }

  .cf-queue-eta-label {
    font-size: 0.75rem;
    color: var(--cf-slate-light);
  }

  .cf-queue-badge {
    padding: 0.25rem 0.6rem;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-radius: 4px;
    background: rgba(16, 185, 129, 0.1);
    color: var(--cf-success);
  }

  .cf-queue-item.emergency .cf-queue-badge {
    background: rgba(239, 68, 68, 0.1);
    color: var(--cf-emergency);
  }

  .cf-queue-item.urgent .cf-queue-badge {
    background: rgba(245, 158, 11, 0.1);
    color: var(--cf-urgent);
  }

  /* Floating elements */
  .cf-float-card {
    position: absolute;
    background: white;
    border-radius: 16px;
    padding: var(--space-md);
    box-shadow:
      0 4px 6px rgba(15, 23, 42, 0.04),
      0 10px 20px rgba(15, 23, 42, 0.08);
    border: 1px solid rgba(15, 23, 42, 0.06);
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .cf-float-wait {
    top: 20%;
    left: -60px;
    animation-delay: -1s;
  }

  .cf-float-reduction {
    bottom: 15%;
    right: -40px;
    animation-delay: -3s;
  }

  .cf-float-card-label {
    font-size: 0.75rem;
    color: var(--cf-slate-light);
    margin-bottom: 4px;
  }

  .cf-float-card-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--cf-navy);
  }

  .cf-float-card-value span {
    color: var(--cf-success);
  }

  /* ═══════════════════════════════════════════════════════════════
     SOCIAL PROOF BAR
     ═══════════════════════════════════════════════════════════════ */

  .cf-proof {
    padding: var(--space-xl) var(--space-xl);
    background: var(--cf-cream);
    border-top: 1px solid rgba(15, 23, 42, 0.06);
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
  }

  .cf-proof-inner {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .cf-proof-label {
    font-size: 0.85rem;
    color: var(--cf-slate-light);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-lg);
  }

  .cf-proof-metrics {
    display: flex;
    justify-content: center;
    gap: var(--space-2xl);
    flex-wrap: wrap;
  }

  .cf-proof-metric {
    text-align: center;
  }

  .cf-proof-metric-value {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 400;
    color: var(--cf-navy);
    line-height: 1;
  }

  .cf-proof-metric-value span {
    color: var(--cf-accent);
  }

  .cf-proof-metric-label {
    font-size: 0.9rem;
    color: var(--cf-slate-light);
    margin-top: var(--space-xs);
  }

  /* ═══════════════════════════════════════════════════════════════
     PROBLEM / SOLUTION SECTION
     ═══════════════════════════════════════════════════════════════ */

  .cf-problem {
    padding: var(--space-3xl) var(--space-xl);
    background: var(--cf-navy);
    color: white;
    position: relative;
    overflow: hidden;
  }

  .cf-problem::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(ellipse at 20% 80%, rgba(14, 165, 233, 0.1) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 20%, rgba(16, 185, 129, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }

  .cf-problem-inner {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .cf-problem-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--space-2xl);
  }

  .cf-section-eyebrow {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--cf-accent);
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .cf-section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: var(--space-md);
  }

  .cf-section-title em {
    font-style: italic;
  }

  .cf-problem-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .cf-pain-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: var(--space-lg);
    transition: all 0.4s var(--ease-out-expo);
  }

  .cf-pain-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
    transform: translateY(-4px);
  }

  .cf-pain-icon {
    width: 48px;
    height: 48px;
    background: rgba(239, 68, 68, 0.15);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-md);
  }

  .cf-pain-icon svg {
    width: 24px;
    height: 24px;
    color: #fca5a5;
  }

  .cf-pain-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .cf-pain-desc {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
  }

  .cf-pain-stat {
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.85rem;
  }

  .cf-pain-stat strong {
    color: var(--cf-emergency);
    font-weight: 700;
  }

  /* ═══════════════════════════════════════════════════════════════
     FEATURES SECTION
     ═══════════════════════════════════════════════════════════════ */

  .cf-features {
    padding: var(--space-3xl) var(--space-xl);
    background: var(--cf-warm-white);
  }

  .cf-features-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .cf-features-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--space-2xl);
  }

  .cf-features-header .cf-section-eyebrow {
    color: var(--cf-accent);
  }

  .cf-features-header .cf-section-title {
    color: var(--cf-navy);
  }

  .cf-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .cf-feature-card {
    background: white;
    border-radius: 20px;
    padding: var(--space-lg);
    border: 1px solid rgba(15, 23, 42, 0.06);
    transition: all 0.4s var(--ease-out-expo);
    position: relative;
    overflow: hidden;
  }

  .cf-feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--cf-accent) 0%, var(--cf-success) 100%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .cf-feature-card:hover {
    transform: translateY(-8px);
    box-shadow:
      0 8px 16px rgba(15, 23, 42, 0.04),
      0 20px 40px rgba(15, 23, 42, 0.08);
  }

  .cf-feature-card:hover::before {
    transform: scaleX(1);
  }

  .cf-feature-icon {
    width: 56px;
    height: 56px;
    background: var(--cf-accent-glow);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-md);
  }

  .cf-feature-icon svg {
    width: 28px;
    height: 28px;
    color: var(--cf-accent);
  }

  .cf-feature-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--cf-navy);
    margin-bottom: var(--space-xs);
  }

  .cf-feature-desc {
    font-size: 0.95rem;
    color: var(--cf-slate-light);
    line-height: 1.6;
  }

  /* ═══════════════════════════════════════════════════════════════
     RESULTS / CASE STUDY SECTION
     ═══════════════════════════════════════════════════════════════ */

  .cf-results {
    padding: var(--space-3xl) var(--space-xl);
    background: linear-gradient(180deg, var(--cf-cream) 0%, var(--cf-warm-white) 100%);
  }

  .cf-results-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .cf-results-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--space-2xl);
  }

  .cf-results-showcase {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .cf-results-visual {
    position: relative;
  }

  .cf-results-chart {
    background: white;
    border-radius: 24px;
    padding: var(--space-xl);
    box-shadow:
      0 4px 6px rgba(15, 23, 42, 0.02),
      0 12px 24px rgba(15, 23, 42, 0.05);
    border: 1px solid rgba(15, 23, 42, 0.06);
  }

  .cf-chart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }

  .cf-chart-title {
    font-weight: 600;
    color: var(--cf-navy);
  }

  .cf-chart-legend {
    display: flex;
    gap: var(--space-md);
    font-size: 0.8rem;
  }

  .cf-chart-legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--cf-slate-light);
  }

  .cf-chart-legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }

  .cf-chart-legend-dot.before { background: #cbd5e1; }
  .cf-chart-legend-dot.after { background: var(--cf-accent); }

  .cf-chart-bars {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .cf-chart-bar-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cf-chart-bar-label {
    font-size: 0.85rem;
    color: var(--cf-slate);
    font-weight: 500;
  }

  .cf-chart-bar-track {
    height: 12px;
    background: var(--cf-cream);
    border-radius: 6px;
    overflow: hidden;
    position: relative;
  }

  .cf-chart-bar-fill {
    height: 100%;
    border-radius: 6px;
    transition: width 1.5s var(--ease-out-expo);
  }

  .cf-chart-bar-fill.before {
    background: #cbd5e1;
  }

  .cf-chart-bar-fill.after {
    background: linear-gradient(90deg, var(--cf-accent) 0%, var(--cf-success) 100%);
  }

  .cf-results-content {
    padding-left: var(--space-xl);
  }

  .cf-result-metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .cf-result-metric {
    background: white;
    border-radius: 16px;
    padding: var(--space-lg);
    border: 1px solid rgba(15, 23, 42, 0.06);
    text-align: center;
  }

  .cf-result-metric-value {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 400;
    color: var(--cf-accent);
    line-height: 1;
  }

  .cf-result-metric-label {
    font-size: 0.9rem;
    color: var(--cf-slate-light);
    margin-top: var(--space-xs);
  }

  .cf-testimonial {
    background: white;
    border-radius: 16px;
    padding: var(--space-lg);
    border: 1px solid rgba(15, 23, 42, 0.06);
    position: relative;
  }

  .cf-testimonial::before {
    content: '"';
    position: absolute;
    top: var(--space-sm);
    left: var(--space-lg);
    font-family: var(--font-display);
    font-size: 4rem;
    color: var(--cf-accent-glow);
    line-height: 1;
  }

  .cf-testimonial-quote {
    font-size: 1.05rem;
    color: var(--cf-slate);
    line-height: 1.7;
    margin-bottom: var(--space-md);
    font-style: italic;
  }

  .cf-testimonial-author {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .cf-testimonial-avatar {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, var(--cf-accent) 0%, var(--cf-success) 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: white;
    font-size: 0.9rem;
  }

  .cf-testimonial-name {
    font-weight: 600;
    color: var(--cf-navy);
    font-size: 0.95rem;
  }

  .cf-testimonial-role {
    font-size: 0.85rem;
    color: var(--cf-slate-light);
  }

  /* ═══════════════════════════════════════════════════════════════
     PRICING SECTION
     ═══════════════════════════════════════════════════════════════ */

  .cf-pricing {
    padding: var(--space-3xl) var(--space-xl);
    background: var(--cf-warm-white);
  }

  .cf-pricing-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .cf-pricing-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-2xl);
  }

  .cf-pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    align-items: start;
  }

  .cf-pricing-card {
    background: white;
    border-radius: 24px;
    padding: var(--space-xl);
    border: 1px solid rgba(15, 23, 42, 0.06);
    transition: all 0.4s var(--ease-out-expo);
    position: relative;
  }

  .cf-pricing-card.featured {
    background: var(--cf-navy);
    color: white;
    transform: scale(1.05);
    box-shadow:
      0 8px 16px rgba(15, 23, 42, 0.1),
      0 24px 48px rgba(15, 23, 42, 0.15);
  }

  .cf-pricing-card:not(.featured):hover {
    transform: translateY(-8px);
    box-shadow:
      0 8px 16px rgba(15, 23, 42, 0.04),
      0 20px 40px rgba(15, 23, 42, 0.08);
  }

  .cf-pricing-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.4rem 1rem;
    background: var(--cf-accent);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 100px;
  }

  .cf-pricing-name {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .cf-pricing-desc {
    font-size: 0.9rem;
    opacity: 0.7;
    margin-bottom: var(--space-lg);
  }

  .cf-pricing-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-bottom: var(--space-lg);
  }

  .cf-pricing-currency {
    font-size: 1.5rem;
    font-weight: 600;
    opacity: 0.6;
  }

  .cf-pricing-amount {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 400;
    line-height: 1;
  }

  .cf-pricing-period {
    font-size: 0.9rem;
    opacity: 0.6;
  }

  .cf-pricing-features {
    list-style: none;
    margin-bottom: var(--space-lg);
  }

  .cf-pricing-feature {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-xs) 0;
    font-size: 0.95rem;
  }

  .cf-pricing-feature svg {
    width: 18px;
    height: 18px;
    color: var(--cf-success);
    flex-shrink: 0;
  }

  .cf-pricing-card.featured .cf-pricing-feature svg {
    color: #86efac;
  }

  .cf-pricing-cta {
    display: block;
    width: 100%;
    padding: 1rem;
    text-align: center;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s var(--ease-out-expo);
  }

  .cf-pricing-card:not(.featured) .cf-pricing-cta {
    background: var(--cf-cream);
    color: var(--cf-navy);
  }

  .cf-pricing-card:not(.featured) .cf-pricing-cta:hover {
    background: var(--cf-navy);
    color: white;
  }

  .cf-pricing-card.featured .cf-pricing-cta {
    background: white;
    color: var(--cf-navy);
  }

  .cf-pricing-card.featured .cf-pricing-cta:hover {
    background: var(--cf-accent);
    color: white;
  }

  /* ═══════════════════════════════════════════════════════════════
     CTA SECTION
     ═══════════════════════════════════════════════════════════════ */

  .cf-cta {
    padding: var(--space-3xl) var(--space-xl);
    background: linear-gradient(135deg, var(--cf-navy) 0%, var(--cf-navy-90) 100%);
    color: white;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cf-cta::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(ellipse at center, var(--cf-accent-glow) 0%, transparent 50%);
    animation: rotate 20s linear infinite;
  }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .cf-cta-inner {
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .cf-cta-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: var(--space-md);
  }

  .cf-cta-title em {
    font-style: italic;
    color: var(--cf-accent);
  }

  .cf-cta-subtitle {
    font-size: 1.15rem;
    opacity: 0.8;
    margin-bottom: var(--space-xl);
  }

  .cf-cta-actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .cf-cta .cf-btn-primary {
    background: white;
    color: var(--cf-navy);
  }

  .cf-cta .cf-btn-primary:hover {
    background: var(--cf-accent);
    color: white;
  }

  .cf-cta .cf-btn-secondary {
    color: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 1rem 1.5rem;
    border-radius: 100px;
  }

  .cf-cta .cf-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* ═══════════════════════════════════════════════════════════════
     FOOTER
     ═══════════════════════════════════════════════════════════════ */

  .cf-footer {
    padding: var(--space-2xl) var(--space-xl) var(--space-xl);
    background: var(--cf-navy);
    color: white;
  }

  .cf-footer-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .cf-footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-2xl);
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cf-footer-brand {
    max-width: 300px;
  }

  .cf-footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .cf-footer-logo .cf-logo-mark {
    width: 36px;
    height: 36px;
    border-radius: 10px;
  }

  .cf-footer-logo .cf-logo-mark svg {
    width: 20px;
    height: 20px;
  }

  .cf-footer-logo .cf-logo-text {
    font-size: 1.25rem;
    color: white;
  }

  .cf-footer-tagline {
    font-size: 0.95rem;
    opacity: 0.6;
    line-height: 1.6;
  }

  .cf-footer-section h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.5;
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .cf-footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .cf-footer-link {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .cf-footer-link:hover {
    color: white;
  }

  .cf-footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cf-footer-copy {
    font-size: 0.85rem;
    opacity: 0.5;
  }

  .cf-footer-socials {
    display: flex;
    gap: var(--space-md);
  }

  .cf-footer-social {
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.6);
    transition: all 0.3s ease;
  }

  .cf-footer-social:hover {
    background: var(--cf-accent);
    color: white;
  }

  .cf-footer-social svg {
    width: 20px;
    height: 20px;
  }

  /* ═══════════════════════════════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════════════════════════════ */

  @media (max-width: 1024px) {
    .cf-hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .cf-hero-visual {
      max-width: 600px;
      margin: 0 auto;
    }

    .cf-float-card {
      display: none;
    }

    .cf-problem-grid {
      grid-template-columns: 1fr;
    }

    .cf-features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cf-results-showcase {
      grid-template-columns: 1fr;
    }

    .cf-results-content {
      padding-left: 0;
      padding-top: var(--space-xl);
    }

    .cf-pricing-grid {
      grid-template-columns: 1fr;
      max-width: 400px;
      margin: 0 auto;
    }

    .cf-pricing-card.featured {
      transform: none;
      order: -1;
    }

    .cf-footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  @media (max-width: 768px) {
    .cf-nav {
      padding: var(--space-sm) var(--space-md);
    }

    .cf-nav-links {
      display: none;
    }

    .cf-hero {
      padding: calc(var(--space-2xl) + 60px) var(--space-md) var(--space-2xl);
    }

    .cf-hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .cf-proof-metrics {
      gap: var(--space-lg);
    }

    .cf-features-grid {
      grid-template-columns: 1fr;
    }

    .cf-result-metrics {
      grid-template-columns: 1fr;
    }

    .cf-footer-grid {
      grid-template-columns: 1fr;
    }

    .cf-footer-bottom {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
    }
  }
</style>

