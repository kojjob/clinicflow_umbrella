  <!-- Problem Section -->
  <section class="cf-problem">
    <div class="cf-problem-inner">
      <div class="cf-problem-header">
        <div class="cf-section-eyebrow">The Problem</div>
        <h2 class="cf-section-title">
          Your waiting room is <em>bleeding</em> revenue
        </h2>
      </div>
      <div class="cf-problem-grid">
        <div class="cf-pain-card">
          <div class="cf-pain-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="cf-pain-title">Excessive Wait Times</h3>
          <p class="cf-pain-desc">Paper lists and verbal name-calling create 2-3x longer waits than necessary. Patients leave frustrated, staff burn out.</p>
          <div class="cf-pain-stat">Industry average: <strong>45+ minutes</strong> per patient</div>
        </div>
        <div class="cf-pain-card">
          <div class="cf-pain-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
            </svg>
          </div>
          <h3 class="cf-pain-title">Skyrocketing No-Shows</h3>
          <p class="cf-pain-desc">Without real-time notifications, patients miss their turn. Empty slots can't be filled. Revenue walks out the door.</p>
          <div class="cf-pain-stat">Average no-show rate: <strong>15-25%</strong></div>
        </div>
        <div class="cf-pain-card">
          <div class="cf-pain-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="cf-pain-title">Unbalanced Workloads</h3>
          <p class="cf-pain-desc">Some doctors overloaded while rooms sit empty. No visibility into real-time capacity means constant bottlenecks.</p>
          <div class="cf-pain-stat">Room idle time: <strong>up to 27%</strong></div>
        </div>
        <div class="cf-pain-card">
          <div class="cf-pain-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="cf-pain-title">Zero Visibility</h3>
          <p class="cf-pain-desc">No analytics means decisions based on guesswork. Can't identify bottlenecks, peak hours, or underperforming branches.</p>
          <div class="cf-pain-stat">Decisions made on: <strong>intuition, not data</strong></div>
        </div>
      </div>
    </div>
  </section>

