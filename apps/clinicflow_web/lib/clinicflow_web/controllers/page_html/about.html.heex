<%!-- About Page for ClinicFlow --%>
<%!-- Editorial Medical Luxury aesthetic - confident, warm, sophisticated --%>

<style>
  /* ═══════════════════════════════════════════════════════════════
     CLINICFLOW ABOUT PAGE
     ═══════════════════════════════════════════════════════════════ */

  @import url('https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

  :root {
    --cf-navy: #0f172a;
    --cf-navy-90: #1e293b;
    --cf-slate: #334155;
    --cf-slate-light: #64748b;
    --cf-warm-white: #fafaf9;
    --cf-cream: #f5f5f4;
    --cf-accent: #0ea5e9;
    --cf-accent-dark: #0284c7;
    --cf-accent-glow: rgba(14, 165, 233, 0.15);
    --cf-success: #10b981;
    --cf-urgent: #f59e0b;
    --cf-emergency: #ef4444;
    --font-display: 'Instrument Serif', Georgia, serif;
    --font-body: 'Plus Jakarta Sans', system-ui, sans-serif;
    --space-xs: 0.5rem;
    --space-sm: 1rem;
    --space-md: 1.5rem;
    --space-lg: 2.5rem;
    --space-xl: 4rem;
    --space-2xl: 6rem;
    --space-3xl: 10rem;
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --transition-base: 0.4s var(--ease-out-expo);
  }

  .about-page * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .about-page {
    font-family: var(--font-body);
    color: var(--cf-navy);
    background: var(--cf-warm-white);
    overflow-x: hidden;
    line-height: 1.6;
  }

  /* Navigation CSS moved to MarketingComponents.navbar/1 - Uses Tailwind CSS v4 */

  .cf-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, var(--cf-accent) 0%, var(--cf-accent-dark) 100%);
    color: white;
    padding: 1rem 2rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    transition: var(--transition-base);
    box-shadow: 0 4px 14px var(--cf-accent-glow);
  }

  .cf-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px var(--cf-accent-glow);
  }

  .cf-btn-primary svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .cf-btn-primary:hover svg {
    transform: translateX(4px);
  }

  .cf-btn-full {
    width: 100%;
  }

  /* Hero Section */
  .about-hero {
    padding: calc(var(--space-3xl) + 80px) var(--space-xl) var(--space-2xl);
    background: linear-gradient(180deg, var(--cf-cream) 0%, var(--cf-warm-white) 100%);
    position: relative;
    overflow: hidden;
  }

  .about-hero::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 80%;
    height: 200%;
    background: radial-gradient(ellipse, var(--cf-accent-glow) 0%, transparent 70%);
    pointer-events: none;
  }

  .about-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
    align-items: center;
    position: relative;
  }

  .about-hero-content {
    animation: fadeInUp 0.8s var(--ease-out-expo) forwards;
  }

  .about-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--cf-accent-glow);
    color: var(--cf-accent-dark);
    padding: 0.5rem 1rem;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
  }

  .about-hero-eyebrow svg {
    width: 16px;
    height: 16px;
  }

  .about-hero-headline {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    margin-bottom: var(--space-md);
  }

  .about-hero-headline em {
    font-style: italic;
    color: var(--cf-accent);
  }

  .about-hero-subhead {
    font-size: 1.25rem;
    color: var(--cf-slate);
    line-height: 1.7;
    max-width: 500px;
  }

  .about-hero-visual {
    position: relative;
    animation: fadeInUp 0.8s var(--ease-out-expo) 0.2s forwards;
    opacity: 0;
  }

  .about-hero-image {
    width: 100%;
    height: 500px;
    background: linear-gradient(135deg, var(--cf-navy-90) 0%, var(--cf-navy) 100%);
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
  }

  .about-hero-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    opacity: 0.5;
  }

  .healthcare-illustration {
    position: relative;
    z-index: 1;
  }

  .healthcare-illustration svg {
    width: 280px;
    height: 280px;
    color: white;
    opacity: 0.9;
  }

  .floating-badge {
    position: absolute;
    background: white;
    border-radius: 16px;
    padding: 1rem 1.25rem;
    box-shadow: 0 10px 40px rgba(15, 23, 42, 0.15);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    animation: float 6s ease-in-out infinite;
  }

  .floating-badge.mission {
    top: 60px;
    right: -20px;
    animation-delay: 0s;
  }

  .floating-badge.impact {
    bottom: 80px;
    left: -30px;
    animation-delay: -2s;
  }

  .floating-badge-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .floating-badge-icon.green {
    background: rgba(16, 185, 129, 0.1);
    color: var(--cf-success);
  }

  .floating-badge-icon.blue {
    background: var(--cf-accent-glow);
    color: var(--cf-accent);
  }

  .floating-badge-icon svg {
    width: 22px;
    height: 22px;
  }

  .floating-badge-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--cf-navy);
  }

  .floating-badge-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--cf-accent);
  }

  /* Mission Section */
  .mission-section {
    padding: var(--space-3xl) var(--space-xl);
    background: white;
  }

  .mission-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .mission-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .mission-card {
    background: var(--cf-cream);
    border-radius: 20px;
    padding: var(--space-xl);
    position: relative;
    overflow: hidden;
    transition: var(--transition-base);
  }

  .mission-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.1);
  }

  .mission-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--cf-accent) 0%, var(--cf-success) 100%);
  }

  .mission-icon {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-md);
    background: white;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
  }

  .mission-icon svg {
    width: 28px;
    height: 28px;
    color: var(--cf-accent);
  }

  .mission-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
    color: var(--cf-navy);
  }

  .mission-desc {
    color: var(--cf-slate);
    line-height: 1.7;
  }

  /* Values Section */
  .values-section {
    padding: var(--space-3xl) var(--space-xl);
    background: var(--cf-navy);
    color: white;
    position: relative;
    overflow: hidden;
  }

  .values-section::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background: radial-gradient(ellipse at right, rgba(14, 165, 233, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .values-inner {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  .values-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .section-eyebrow {
    display: inline-block;
    color: var(--cf-accent);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-sm);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.2;
  }

  .section-title em {
    font-style: italic;
    color: var(--cf-accent);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .value-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: var(--space-lg);
    text-align: center;
    transition: var(--transition-base);
  }

  .value-card:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-4px);
    border-color: var(--cf-accent);
  }

  .value-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto var(--space-md);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cf-accent-glow);
  }

  .value-icon svg {
    width: 30px;
    height: 30px;
    color: var(--cf-accent);
  }

  .value-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .value-desc {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
  }

  /* Team Section */
  .team-section {
    padding: var(--space-3xl) var(--space-xl);
    background: var(--cf-cream);
  }

  .team-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .team-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .team-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    transition: var(--transition-base);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
  }

  .team-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.12);
  }

  .team-avatar {
    width: 100%;
    height: 280px;
    background: linear-gradient(135deg, var(--cf-slate-light) 0%, var(--cf-slate) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .team-avatar::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M20 0v40M0 20h40'/%3E%3C/g%3E%3C/svg%3E");
  }

  .team-avatar svg {
    width: 100px;
    height: 100px;
    color: rgba(255, 255, 255, 0.4);
    position: relative;
    z-index: 1;
  }

  .team-info {
    padding: var(--space-lg);
  }

  .team-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin-bottom: 0.25rem;
    color: var(--cf-navy);
  }

  .team-role {
    color: var(--cf-accent);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: var(--space-sm);
  }

  .team-bio {
    color: var(--cf-slate);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .team-social {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .team-social-link {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--cf-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cf-slate);
    transition: var(--transition-base);
  }

  .team-social-link:hover {
    background: var(--cf-accent);
    color: white;
  }

  .team-social-link svg {
    width: 18px;
    height: 18px;
  }

  /* CTA Section */
  .cta-section {
    padding: var(--space-3xl) var(--space-xl);
    background: white;
  }

  .cta-inner {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .cta-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: var(--space-md);
  }

  .cta-headline em {
    font-style: italic;
    color: var(--cf-accent);
  }

  .cta-subhead {
    font-size: 1.25rem;
    color: var(--cf-slate);
    margin-bottom: var(--space-xl);
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
  }

  .cta-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--cf-accent);
    color: white;
    padding: 1rem 2rem;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition-base);
  }

  .cta-btn-primary:hover {
    background: var(--cf-accent-dark);
    transform: translateY(-2px);
  }

  .cta-btn-primary svg {
    width: 20px;
    height: 20px;
  }

  .cta-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: var(--cf-navy);
    padding: 1rem 2rem;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    border: 2px solid var(--cf-navy);
    transition: var(--transition-base);
  }

  .cta-btn-secondary:hover {
    background: var(--cf-navy);
    color: white;
  }

  /* Footer */
  .cf-footer {
    background: var(--cf-navy);
    color: white;
    padding: var(--space-2xl) var(--space-xl) var(--space-lg);
  }

  .cf-footer-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .cf-footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  .cf-footer-brand {
    max-width: 300px;
  }

  .cf-footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .cf-footer-logo-mark {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--cf-accent) 0%, var(--cf-accent-dark) 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cf-footer-logo-mark svg {
    width: 22px;
    height: 22px;
    color: white;
  }

  .cf-footer-logo-text {
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .cf-footer-tagline {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .cf-footer-column-title {
    font-weight: 600;
    margin-bottom: var(--space-md);
    color: white;
  }

  .cf-footer-links {
    list-style: none;
  }

  .cf-footer-links li {
    margin-bottom: var(--space-xs);
  }

  .cf-footer-links a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.3s ease;
  }

  .cf-footer-links a:hover {
    color: var(--cf-accent);
  }

  .cf-footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--space-lg);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cf-footer-copy {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9rem;
  }

  .cf-footer-social {
    display: flex;
    gap: var(--space-sm);
  }

  .cf-footer-social a {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.7);
    transition: var(--transition-base);
  }

  .cf-footer-social a:hover {
    background: var(--cf-accent);
    color: white;
  }

  .cf-footer-social svg {
    width: 20px;
    height: 20px;
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .about-hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .about-hero-subhead {
      max-width: 100%;
      margin: 0 auto;
    }

    .about-hero-visual {
      display: none;
    }

    .mission-grid {
      grid-template-columns: 1fr;
    }

    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .team-grid {
      grid-template-columns: 1fr;
    }

    .cf-footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
    }
  }

  @media (max-width: 768px) {
    .cf-nav-links {
      display: none;
    }

    .values-grid {
      grid-template-columns: 1fr;
    }

    .cta-buttons {
      flex-direction: column;
    }

    .cf-footer-grid {
      grid-template-columns: 1fr;
    }

    .cf-footer-bottom {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
    }
  }
</style>

<div class="about-page">
  <!-- Shared Navbar Component (Tailwind CSS v4) -->
  <ClinicflowWeb.MarketingComponents.navbar current_page="about" />

  <!-- Navbar Spacer for fixed navbar -->
  <div class="h-16 lg:h-18"></div>

  <!-- Hero Section -->
  <section class="about-hero">
    <div class="about-hero-inner">
      <div class="about-hero-content">
        <div class="about-hero-eyebrow">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          Our Story
        </div>
        <h1 class="about-hero-headline">
          Built by healthcare <em>professionals</em>, for clinics
        </h1>
        <p class="about-hero-subhead">
          We understand the chaos of a busy waiting room. That's why we built ClinicFlow - to bring calm, efficiency, and better patient experiences to clinics worldwide.
        </p>
      </div>
      <div class="about-hero-visual">
        <div class="about-hero-image">
          <div class="healthcare-illustration">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <div class="floating-badge mission">
            <div class="floating-badge-icon green">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <div class="floating-badge-text">Mission-Driven</div>
              <div class="floating-badge-value">Since 2023</div>
            </div>
          </div>
          <div class="floating-badge impact">
            <div class="floating-badge-icon blue">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
